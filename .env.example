# Keys for the Ask Ayush chatbot. Copy this file to .env.local for local dev, and add the same
# variables in your Vercel project settings. With no working key the chatbot still answers: it falls
# back to searching the résumé in the browser.

# First choice: OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Optional. Any model id from https://openrouter.ai/models. Defaults to anthropic/claude-sonnet-5.5.
# anthropic/claude-haiku-4.5 is cheaper per question but got a fact wrong in testing.
# OPENROUTER_MODEL=

# Fallback, tried when OpenRouter can't answer: Google Gemini API (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
# GOOGLE_MODEL=
